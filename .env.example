APP_NAME="SoloInventory"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8091
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# No default credentials. Generate the hash with soloinventory:password-hash.
SOLOINVENTORY_USERNAME=
# Keep bcrypt hashes in single quotes so Compose preserves the $ characters.
SOLOINVENTORY_PASSWORD_HASH=''

DB_CONNECTION=sqlite
# Only needed for native PHP. Compose sets the database path inside its data volume.
# DB_DATABASE=/absolute/path/to/storage/app/soloinventory.sqlite
SESSION_DRIVER=file
SESSION_COOKIE=soloinventory_session
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
LOG_CHANNEL=stderr
LOG_LEVEL=warning
BCRYPT_ROUNDS=12

# If this file is renamed, also pass --env-file <filename> to Compose.
SOLOINVENTORY_ENV_FILE=.env
SOLOINVENTORY_BIND_IP=127.0.0.1
SOLOINVENTORY_HTTP_PORT=8091
SOLOINVENTORY_IMAGE=ghcr.io/metalogico/soloinventory:1.0.0

# Optional private-network HTTPS override; see docs/https.md.
SOLOINVENTORY_HOST=soloinventory.home.arpa
SOLOINVENTORY_HTTPS_PORT=8444

# Optional operator-managed scheduled backup; see docs/backup-and-restore.md.
# This must be an existing directory on a separate disk.
SOLOINVENTORY_BACKUP_DIR=
SOLOINVENTORY_BACKUP_VOLUME_ID=
